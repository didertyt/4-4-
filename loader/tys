local placeId = game.PlaceId

local supported = {
    [15269951959] = "https://voidedx.vercel.app/api/raw?id=vx_3qbe4upg",
    [4924922222]  = "https://voidedx.vercel.app/api/raw?id=vx_xrkkl4py",
    [142823291]   = "https://voidedx.vercel.app/api/raw?id=vx_ng7d02vd",
}

local scriptUrl = supported[placeId]

if scriptUrl then
    local ok, err = pcall(function()
        loadstring(game:HttpGet(scriptUrl))()
    end)
    if not ok then
        warn("[Tys Client] Failed to load: " .. tostring(err))
    end
else
    task.wait(1)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Tys Client",
            Text = "Game not supported! Supported games: Brookhaven RP, Legends Battlegrounds, MM2",
            Duration = 10,
        })
    end)
end
