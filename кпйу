-- === 2. ЛОГИКА АВТО-ХОДЬБЫ И ВРАЩЕНИЯ ВЛЕВО ===
local isAutoWalking = false
local walkConnection = nil

local function setAutoWalk(state)
	if isAutoWalking == state then return end
	isAutoWalking = state
	local camera = Workspace.CurrentCamera

	if isAutoWalking then
		autoWalkBtn.Text = "Авто-ходьба: ВКЛ"
		autoWalkBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 90)

		if camera then
			camera.CameraType = Enum.CameraType.Scriptable
		end

		walkConnection = RunService.RenderStepped:Connect(function(dt)
			local character = player.Character

			if character and character:FindFirstChild("Humanoid") then
				character.Humanoid:Move(Vector3.new(0, 0, -1), true)
				
				if camera and character:FindFirstChild("HumanoidRootPart") then
					local targetPos = character.HumanoidRootPart.Position + Vector3.new(0, 2, 0)
					camera.CFrame = camera.CFrame * CFrame.Angles(0, ROTATION_SPEED * dt, 0)
					camera.CFrame = CFrame.new(targetPos) * (camera.CFrame - camera.CFrame.Position)
				end
			end
		end)
	else
		autoWalkBtn.Text = "Авто-ходьба: ВЫКЛ"
		autoWalkBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)

		if camera then
			camera.CameraType = Enum.CameraType.Custom
		end

		if walkConnection then
			walkConnection:Disconnect()
			walkConnection = nil
		end
	end
end

autoWalkBtn.MouseButton1Click:Connect(function()
	setAutoWalk(not isAutoWalking)
end)

