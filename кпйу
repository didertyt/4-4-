local isAutoWinActive = false
local isExecutingWin = false

local function isGuiElementVisible(element)
	local current = element
	while current and not current:IsA("ScreenGui") do
		if current:IsA("GuiObject") and not current.Visible then
			return false
		end
		current = current.Parent
	end
	return current and current:IsA("ScreenGui") and current.Enabled
end

local function triggerGuiButton(btn)
	if typeof(getconnections) == "function" then
		for _, sig in ipairs({"MouseButton1Click", "MouseButton1Down", "Activated"}) do
			pcall(function()
				for _, conn in ipairs(getconnections(btn[sig])) do
					if conn.Function then
						task.spawn(conn.Function)
					elseif conn.Fire then
						conn:Fire()
					end
				end
			end)
		end
	end

	if typeof(firesignal) == "function" then
		for _, sig in ipairs({"MouseButton1Click", "MouseButton1Down", "Activated"}) do
			pcall(function() firesignal(btn[sig]) end)
		end
	end

	local inset = GuiService:GetGuiInset()
	local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2) + inset

	VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
	task.wait(0.05)
	VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
end

local function findConfirmButton()
	local pg = player:FindFirstChild("PlayerGui")
	if not pg then return nil end

	for _, gui in ipairs(pg:GetChildren()) do
		if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "EgorMenuGui_Small" and not gui.Name:lower():find("dex") then
			for _, elem in ipairs(gui:GetDescendants()) do
				if isGuiElementVisible(elem) then
					if elem:IsA("TextButton") then
						local text = elem.Text:lower():gsub("%s+", "")
						if text == "yes" or text == "да" or elem.Name:lower() == "yes" then
							return elem
						end
					end

					if elem:IsA("TextLabel") and elem.Text:lower():gsub("%s+", "") == "yes" then
						if elem.Parent and (elem.Parent:IsA("GuiButton") or elem.Parent:IsA("Frame")) then
							return elem.Parent
						end
						return elem
					end

					if (elem:IsA("ImageButton") or elem:IsA("Frame")) and elem.Name:lower() == "yes" then
						return elem
					end
				end
			end
		end
	end
	return nil
end

local function findRaceFinishTarget()
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj.Name:lower():match("^race%d*$") then
			local finish = obj:FindFirstChild("FinishPart") or obj:FindFirstChild("finishpart") or obj:FindFirstChild("Finish")
			if finish then
				return finish
			end
			for _, descendant in ipairs(obj:GetDescendants()) do
				if descendant.Name:lower() == "finishpart" then
					return descendant
				end
			end
		end
	end
	return nil
end

local function runAutoWinSequence()
	if isExecutingWin then return end
	isExecutingWin = true

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		isExecutingWin = false
		return
	end

	local returnCFrame = root.CFrame
	setAutoWalk(false)

	local confirmBtn = findConfirmButton()
	if confirmBtn then
		for _ = 1, 3 do
			triggerGuiButton(confirmBtn)
			task.wait(0.1)
		end
	end

	task.wait(31)

	local dest = findRaceFinishTarget()
	character = player.Character
	root = character and character:FindFirstChild("HumanoidRootPart")

	if dest and root then
		local destCFrame = dest:IsA("BasePart") and dest.CFrame or (dest:IsA("Model") and dest:GetPivot())
		if destCFrame then
			root.CFrame = destCFrame + Vector3.new(0, 3, 0)
		end
	end

	task.wait(1.5)

	character = player.Character
	root = character and character:FindFirstChild("HumanoidRootPart")
	if returnCFrame and root then
		root.CFrame = returnCFrame
	end

	task.wait(0.3)
	setAutoWalk(true)
	isExecutingWin = false
end

autoWinBtn.MouseButton1Click:Connect(function()
	isAutoWinActive = not isAutoWinActive
	if isAutoWinActive then
		autoWinBtn.Text = "Авто-победа: ВКЛ"
		autoWinBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 90)
	else
		autoWinBtn.Text = "Авто-победа: ВЫКЛ"
		autoWinBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
	end
end)

task.spawn(function()
